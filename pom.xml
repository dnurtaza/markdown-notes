<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github.dnurtaza</groupId>
	<artifactId>markdown-notes</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>markdown-notes</name>
	<description>
		A note-taking app that lets users upload Markdown files, check the grammar, save the note, and render it in HTML.
	</description>
	<url>https://github.com/dnurtaza/markdown-notes</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>dnurtaza</id>
			<name>Daniyal Nurtaza</name>
			<url>https://github.com/dnurtaza</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/dnurtaza/markdown-notes.git</connection>
		<developerConnection>scm:git:https://github.com/dnurtaza/markdown-notes.git</developerConnection>
		<url>https://github.com/dnurtaza/markdown-notes</url>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
